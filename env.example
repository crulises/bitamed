# Copy to .env before the first `docker compose up`.
#   cp .env.example .env

# core
ENVIRONMENT=development
BASE_URL=http://localhost:8000
# openssl rand -hex 32
SECRET_KEY=change-me-32-bytes-of-random-hex

# database
DATABASE_URL=postgresql+asyncpg://bitamed:bitamed@db:5432/bitamed

# redis / worker
REDIS_URL=redis://redis:6379/0

# object storage (S3 API; MinIO locally, R2/S3 in production) --------
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=bitamed
S3_SECRET_KEY=bitamed-dev-secret
S3_REGION=us-east-1
S3_BUCKET_ORIGINALS=bitamed-originals
S3_BUCKET_DERIVED=bitamed-derived
# Presigned URLs for viewing a file. Short on purpose: the URL leaves our
# control the moment it is generated.
S3_PRESIGN_TTL_SECONDS=300

# ingestion
OCR_LANGUAGES=spa+por
OCR_TIMEOUT_SECONDS=300
MAX_UPLOAD_MB=50
# Perspective correction of phone photos. Disable to fall back to
# ocrmypdf --deskew only.
ENABLE_PERSPECTIVE_CORRECTION=true
# 'rules-v1' today. An LLM-backed extractor plugs in here later without
# touching the schema; the choice is recorded per ingestion_job.
EXTRACTION_ENGINE=rules-v1

# sharing security
SHARE_DEFAULT_TTL_HOURS=72
SHARE_LIVE_MAX_TTL_DAYS=30
# A 4-digit PIN has 10,000 combinations. Without these two values it is
# decoration, not protection.
SHARE_PIN_MAX_ATTEMPTS=5
SHARE_PIN_LOCKOUT_MINUTES=15
# Salt for hashing visitor IPs in the access log. We never store raw IPs.
IP_HASH_SALT=change-me-too

# registration
# false = closed instance, every signup needs admin approval.
ALLOW_OPEN_REGISTRATION=false
INSTANCE_ADMIN_EMAIL=you@example.com

# i18n
DEFAULT_LOCALE=es
SUPPORTED_LOCALES=es,pt,en
DEFAULT_TIMEZONE=America/Argentina/Buenos_Aires

# mail (mailpit in dev)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=bitamed@localhost
